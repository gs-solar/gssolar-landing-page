---
import { recenzie } from '../data/content';

const prvyRad = recenzie.polozky.slice(0, 3);
const druhyRad = recenzie.polozky.slice(3);
---

<section class="bg-cream md:bg-cream/55">
  <div class="mx-auto max-w-[75rem] px-4 py-[3.25rem] md:px-[1.75rem] md:pt-[4.8125rem] md:pb-[3.5rem]">
    <h2 class="text-center font-heading text-[2rem] leading-tight font-bold text-ink md:text-[3.125rem]">
      {recenzie.nadpis}
    </h2>

    {/* Prvý rad — 3 karty, druhý rad — 2 širšie karty centrované */}
    <div class="mt-[2.5rem] flex flex-col items-center gap-[1.5rem] md:mt-[3.1875rem] md:grid md:grid-cols-3 md:items-stretch">
      {
        prvyRad.map((recenzia) => (
          <div class="w-full rounded-[1.25rem] bg-brand-pale p-[1.5rem]">
            <p class="flex flex-wrap items-baseline justify-center gap-x-[1.5rem] md:justify-start">
              <span class="font-heading text-[1.25rem] font-bold text-brand">{recenzia.meno}</span>
              <span class="text-[1.125rem] text-ink">★★★★★</span>
            </p>
            <p class="mt-[0.75rem] text-center text-[0.9375rem] leading-[1.3] text-ink md:text-left md:text-[1rem]">
              {recenzia.text}
            </p>
          </div>
        ))
      }
    </div>
    <div class="mt-[1.5rem] flex flex-col items-center gap-[1.5rem] md:flex-row md:items-stretch md:justify-center md:gap-[2rem]">
      {
        druhyRad.map((recenzia) => (
          <div class="w-full rounded-[1.25rem] bg-brand-pale p-[1.5rem] md:w-[30.25rem]">
            <p class="flex flex-wrap items-baseline justify-center gap-x-[1.5rem] md:justify-start">
              <span class="font-heading text-[1.25rem] font-bold text-brand">{recenzia.meno}</span>
              <span class="text-[1.125rem] text-ink">★★★★★</span>
            </p>
            <p class="mt-[0.75rem] text-center text-[0.9375rem] leading-[1.3] text-ink md:text-left md:text-[1rem]">
              {recenzia.text}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-[2.5rem] text-center md:mt-[3.25rem]">
      <a
        href="#kontakt"
        data-popup-otvor
        class="inline-flex h-[4.1875rem] w-[14.6875rem] items-center justify-center rounded-[1.6875rem] bg-brand text-[1.25rem] font-bold text-white transition hover:opacity-90 md:h-[4.75rem] md:w-[18rem] md:text-[1.375rem]"
      >
        {recenzie.cta}
      </a>
    </div>
  </div>
</section>
