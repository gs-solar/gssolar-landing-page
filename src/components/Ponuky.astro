---
import { ponuky } from '../data/content';

const kartaFarby = {
  light: 'bg-brand-light',
  pale: 'bg-brand-pale',
} as const;
---

<section>
  <div
    class="mx-auto flex max-w-[75rem] flex-col items-center gap-[1.75rem] px-4 py-[1.6875rem] md:h-[54.75rem] md:flex-row md:items-start md:justify-center md:gap-[7.3125rem] md:px-0 md:pt-[2.125rem] md:pb-0"
  >
    {
      ponuky.map((ponuka) => (
        <div class="w-full max-w-[19.3125rem] md:relative md:h-[47.6875rem] md:w-[22.5rem] md:max-w-none">
          {/* Fotka nad kartou — len desktop */}
          <div
            class:list={[
              'absolute top-0 hidden w-full bg-cream bg-fixed bg-center bg-no-repeat md:block',
              ponuka.farbaKarty === 'light' ? 'h-[33.25rem]' : 'h-[27.6875rem] bg-contain',
            ]}
            style={`background-image: url('${ponuka.obrazok}')`}
            aria-hidden="true"
          />
          {/* Arch karta prekrývajúca spodok fotky */}
          <div
            class:list={[
              'flex flex-col items-center rounded-t-[15.625rem] rounded-b-[1.875rem] pb-[2rem] text-center md:absolute md:top-[17.875rem] md:h-[29.8125rem] md:w-full md:pb-0',
              kartaFarby[ponuka.farbaKarty],
            ]}
          >
            <img src={ponuka.ikona} alt="" width="72" height="72" class="mt-[3rem] h-[4.5rem] w-[4.5rem] md:mt-[1.7rem]" />
            <h2 class="mt-[1rem] font-heading text-[1.75rem] leading-none font-bold text-ink md:mt-[1.5rem] md:text-[2rem]">
              {ponuka.titulok}
            </h2>
            <p
              class="mt-[1rem] w-[17rem] text-[0.9375rem] leading-[1.4] text-ink md:mt-[1.3rem] md:w-[19rem] md:text-[1rem]"
              set:html={ponuka.text}
            />
            {/* Button v karte — len desktop */}
            <a
              href="#kontakt"
              data-popup-otvor
              class="absolute bottom-[2.9rem] hidden h-[3.5rem] w-[12.5rem] items-center justify-center rounded-[1.6875rem] bg-brand text-[1rem] font-bold text-white transition hover:opacity-90 md:inline-flex"
            >
              {ponuka.cta}
            </a>
          </div>
          {/* Button pod kartou — len mobil */}
          <div class="mt-[1.1875rem] text-center md:hidden">
            <a
              href="#kontakt"
              data-popup-otvor
              class="inline-flex h-[3.5rem] w-[12.5rem] items-center justify-center rounded-[1.6875rem] bg-brand text-[1rem] font-bold text-white transition hover:opacity-90"
            >
              {ponuka.cta}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
