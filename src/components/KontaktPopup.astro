---
import { zaklad } from '../data/url';
import { formular } from '../data/content';

const inputTriedy =
  'w-full rounded-[3px] border border-[#cccccc] bg-white px-3 text-[1rem] text-ink placeholder:text-[#999999] focus:border-ink focus:outline-none';
---

<dialog
  id="kontakt-popup"
  class="m-auto max-h-[92dvh] w-[min(92vw,47.5rem)] overflow-y-auto bg-white p-[1.5rem] backdrop:bg-black/60 md:p-[2.5rem]"
>
  <button
    type="button"
    data-popup-zavri
    aria-label="Zavrieť formulár"
    class="absolute top-[1rem] right-[1rem] flex h-[2.625rem] w-[2.625rem] items-center justify-center rounded-full border-2 border-ink text-ink transition hover:bg-ink hover:text-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-[1.25rem] w-[1.25rem]">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
  </button>

  <form
    name={formular.nazovFormulara}
    method="POST"
    action={zaklad('/dakujeme/')}
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="mx-auto mt-[2rem] grid max-w-[40rem] grid-cols-1 gap-[1.125rem] md:grid-cols-2 md:gap-x-[1.25rem]"
  >
    <input type="hidden" name="form-name" value={formular.nazovFormulara} />
    <p class="hidden">
      <label>Nevypĺňajte: <input name="bot-field" /></label>
    </p>

    {
      formular.polia.map((pole) => (
        <label class:list={['flex flex-col', pole.celyRiadok && 'md:col-span-2']}>
          <span class="mb-[0.375rem] grow text-[0.9375rem] font-bold text-ink">{pole.label}</span>
          {pole.typ === 'select' ? (
            <select name={pole.name} class:list={[inputTriedy, 'h-[2.5rem]']}>
              <option value="">{pole.placeholder}</option>
              {pole.moznosti.map((moznost) => (
                <option value={moznost}>{moznost}</option>
              ))}
            </select>
          ) : pole.typ === 'textarea' ? (
            <textarea name={pole.name} rows="3" class:list={[inputTriedy, 'py-2']} />
          ) : (
            <input
              type={pole.typ}
              name={pole.name}
              placeholder={pole.placeholder}
              required={pole.povinne}
              class:list={[inputTriedy, 'h-[2.5rem]']}
            />
          )}
        </label>
      ))
    }

    <label class="flex items-center gap-[0.625rem] md:col-span-2">
      <input type="checkbox" name="gdpr-suhlas" required class="h-[1.125rem] w-[1.125rem] accent-brand" />
      <span class="text-[0.9375rem] text-ink">
        <a
          href={formular.gdpr.url}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-brand"
        >
          {formular.gdpr.text}
        </a>
      </span>
    </label>

    <button
      type="submit"
      class="mt-[0.375rem] h-[3.5rem] w-full rounded-[8px] bg-[#e8cc82] font-heading text-[1.375rem] font-bold text-ink transition hover:opacity-90 md:col-span-2"
    >
      {formular.odoslat}
    </button>
  </form>
</dialog>

<script>
  const popup = document.getElementById('kontakt-popup') as HTMLDialogElement | null;

  if (popup) {
    document.querySelectorAll('[data-popup-otvor]').forEach((tlacidlo) => {
      tlacidlo.addEventListener('click', (udalost) => {
        udalost.preventDefault();
        popup.showModal();
      });
    });

    popup.querySelector('[data-popup-zavri]')?.addEventListener('click', () => popup.close());

    // klik na tmavé pozadie mimo obsahu zavrie popup
    popup.addEventListener('click', (udalost) => {
      if (udalost.target === popup) popup.close();
    });
  }
</script>
