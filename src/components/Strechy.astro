---
import { strechy } from '../data/content';
---

<section class="bg-brand-light/60">
  <div class="mx-auto max-w-[75rem] px-4 py-[2.375rem] md:py-[3.375rem] md:pb-[3.75rem]">
    <h2 class="text-center font-heading text-[2rem] leading-tight font-bold text-ink md:text-[2.5rem]">
      {strechy.nadpis}
    </h2>
    <div class="mt-[2.5rem] flex flex-col items-center gap-[2.75rem] md:mt-[2.25rem] md:flex-row md:items-start md:justify-center md:gap-[1rem]">
      {
        strechy.polozky.map((polozka) => (
          <div class="flex w-[14.75rem] flex-col items-center">
            <div class="flex h-[5.8125rem] items-center justify-center">
              <img src={polozka.ikona} alt="" class="max-h-[5.8125rem] w-auto" />
            </div>
            <p class="mt-[0.8rem] text-center text-[1rem] leading-[1.4] text-ink">{polozka.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
