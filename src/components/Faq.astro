---
import { zaklad } from '../data/url';
import { faq } from '../data/content';

const lavyStlpec = faq.polozky.slice(0, 2);
const pravyStlpec = faq.polozky.slice(2);
---

<section class="bg-brand-light/60">
  <div class="mx-auto max-w-[75rem] px-4 py-[3.25rem] md:pt-[3.3125rem] md:pb-[4rem]">
    <h2 class="text-center font-heading text-[2rem] leading-tight font-bold text-ink md:text-[3.125rem]">
      {faq.nadpis}
    </h2>

    <div class="mt-[2.5rem] flex flex-col items-center gap-[1.5rem] md:mt-[3rem] md:flex-row md:items-stretch md:justify-center md:gap-[4.2rem]">
      {
        [lavyStlpec, pravyStlpec].map((stlpec, s) => (
          <div
            class:list={[
              'flex w-full flex-col gap-[1.5rem]',
              s === 0 ? 'md:w-[24.9375rem]' : 'md:w-[21.5rem]',
            ]}
          >
            {stlpec.map((polozka) => (
              <details open class="group bg-[#fffffe] p-[1.25rem] md:grow">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-[0.625rem] bg-white p-[0.9375rem] pb-0 [&::-webkit-details-marker]:hidden">
                  <span class="font-heading text-[1.25rem] leading-[1.25] font-bold text-ink">
                    {polozka.otazka}
                  </span>
                  <img
                    src={zaklad('/images/icon_02e24789.svg')}
                    alt=""
                    class="h-[1.25rem] w-[1.25rem] shrink-0 transition-transform group-open:rotate-180"
                  />
                </summary>
                <div class="space-y-[1rem] bg-white p-[0.9375rem] pt-[1.25rem]">
                  {polozka.odpovede.map((odsek) => (
                    <p class="text-[1rem] leading-[1.4] text-ink">{odsek}</p>
                  ))}
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Plynulé rozbaľovanie <details> — v prehliadačoch bez podpory
     ::details-content sa karta otvorí okamžite. */
  details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      content-visibility 0.35s allow-discrete,
      block-size 0.35s ease;
  }

  details[open]::details-content {
    block-size: auto;
  }
</style>
