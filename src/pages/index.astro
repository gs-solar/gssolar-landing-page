---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ponuky from '../components/Ponuky.astro';
import Strechy from '../components/Strechy.astro';
import Statistiky from '../components/Statistiky.astro';
import Postup from '../components/Postup.astro';
import Recenzie from '../components/Recenzie.astro';
import Faq from '../components/Faq.astro';
import Prace from '../components/Prace.astro';
import BlogCta from '../components/BlogCta.astro';
import Footer from '../components/Footer.astro';
import KontaktPopup from '../components/KontaktPopup.astro';
import { seo, faq } from '../data/content';
import { site } from '../data/site';

const firmaLd = {
  '@context': 'https://schema.org',
  '@type': site.jsonLd.typFirmy,
  name: site.nazovFirmy,
  description: seo.popis,
  url: Astro.site?.href,
  image: new URL(site.ogImage.src, Astro.site).href,
  logo: new URL(site.logo.src, Astro.site).href,
  email: site.kontakt.email,
  telephone: site.kontakt.telefonJsonLd,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.jsonLd.adresa.ulica,
    addressLocality: site.jsonLd.adresa.mesto,
    postalCode: site.jsonLd.adresa.psc,
    addressCountry: site.jsonLd.adresa.krajina,
  },
  areaServed: site.jsonLd.oblastPosobenia,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.polozky.map((polozka) => ({
    '@type': 'Question',
    name: polozka.otazka,
    acceptedAnswer: {
      '@type': 'Answer',
      text: polozka.odpovede.join(' '),
    },
  })),
};
---

<Layout title={seo.titulok} description={seo.popis}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(firmaLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <Header />
  <Hero />
  <Ponuky />
  <Strechy />
  <Statistiky />
  <Postup />
  <Recenzie />
  <Faq />
  <Prace />
  <BlogCta />
  <Footer />
  <KontaktPopup />
</Layout>
